{
  "$id": "https://github.com/snds/dsa/schema/patterns-report.json",
  "title": "dsa patterns report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "dsaVersion": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "properties": {
            "$schema": {
              "description": "JSON Schema URL for editor support.",
              "type": "string"
            },
            "system": {
              "type": "object",
              "properties": {
                "name": {
                  "default": "design-system",
                  "description": "Human name of the design system being measured.",
                  "type": "string"
                },
                "packages": {
                  "default": [],
                  "description": "Import sources that count as design-system components (exact name or package prefix).",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "localAliases": {
                  "default": [],
                  "description": "In-repo import sources that are the design system (shadcn-style owned source), e.g. @/components/ui.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "packages",
                "localAliases"
              ],
              "additionalProperties": false
            },
            "scan": {
              "type": "object",
              "properties": {
                "include": {
                  "default": [
                    "**/*.tsx",
                    "**/*.jsx"
                  ],
                  "description": "Glob patterns of files to scan, relative to the config root.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exclude": {
                  "default": [
                    "**/node_modules/**",
                    "**/dist/**",
                    "**/*.test.tsx",
                    "**/*.spec.tsx",
                    "**/*.stories.tsx"
                  ],
                  "description": "Glob patterns to leave out.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "include",
                "exclude"
              ],
              "additionalProperties": false
            },
            "hosts": {
              "type": "object",
              "properties": {
                "by": {
                  "default": "file",
                  "description": "What counts as one host when counting pattern spread: a file or its directory.",
                  "type": "string",
                  "enum": [
                    "file",
                    "dir"
                  ]
                }
              },
              "required": [
                "by"
              ],
              "additionalProperties": false
            },
            "patterns": {
              "type": "object",
              "properties": {
                "minOccurrences": {
                  "default": 3,
                  "description": "Occurrences needed before a composition is more than a snowflake (rule of three).",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "minHosts": {
                  "default": 2,
                  "description": "Distinct hosts needed before a composition is more than a snowflake.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "minComponents": {
                  "default": 2,
                  "description": "Minimum design-system or local components in a composition for it to be considered.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "ignoreIgnoredTimes": {
                  "default": 3,
                  "description": "A candidate ignored this many times is parked and no longer raised.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "minOccurrences",
                "minHosts",
                "minComponents",
                "ignoreIgnoredTimes"
              ],
              "additionalProperties": false
            },
            "correctUse": {
              "type": "object",
              "properties": {
                "rawElements": {
                  "default": [
                    "button"
                  ],
                  "description": "Plain HTML tags that bypass the design system when written in a consumer (counted as rawElements). An element handed to a component through a prop, e.g. render={<button />}, is the system's element and isn't counted.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "rawElements"
              ],
              "additionalProperties": false
            },
            "ratchet": {
              "type": "object",
              "properties": {
                "baseline": {
                  "default": ".dsa/baseline.json",
                  "description": "Path of the correct-use baseline, relative to the config root.",
                  "type": "string"
                }
              },
              "required": [
                "baseline"
              ],
              "additionalProperties": false
            },
            "output": {
              "type": "object",
              "properties": {
                "dir": {
                  "default": ".dsa",
                  "description": "Directory the CLI writes JSON reports to, relative to the config root.",
                  "type": "string"
                }
              },
              "required": [
                "dir"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "system",
            "scan",
            "hosts",
            "patterns",
            "correctUse",
            "ratchet",
            "output"
          ],
          "additionalProperties": false,
          "description": "dsa.config.json — configuration for @snds/dsa."
        },
        "configPath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dsaVersion",
        "generatedAt",
        "config",
        "configPath"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "string"
    },
    "system": {
      "type": "string"
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "minOccurrences": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minHosts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minComponents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "hostsBy": {
          "type": "string",
          "enum": [
            "file",
            "dir"
          ]
        }
      },
      "required": [
        "minOccurrences",
        "minHosts",
        "minComponents",
        "hostsBy"
      ],
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$",
            "description": "Stable hash of the anatomy."
          },
          "name": {
            "type": "string",
            "description": "Candidate name by intent."
          },
          "anatomy": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ds",
                  "local",
                  "html"
                ]
              },
              "shapeProps": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "children": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "component",
              "kind",
              "shapeProps",
              "children"
            ],
            "additionalProperties": false,
            "description": "Slot tree: component, kind, shape props, children."
          },
          "occurrences": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "file",
                "line",
                "column"
              ],
              "additionalProperties": false
            }
          },
          "hosts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Distinct hosts (files by default)."
          },
          "tier": {
            "type": "string",
            "enum": [
              "pattern",
              "compound-component",
              "variant",
              "snowflake"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "nearestExisting": {
            "description": "Closest catalog pattern or already-named local component, when one is close.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "catalog",
                  "local"
                ]
              }
            },
            "required": [
              "name",
              "score",
              "source"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "description": "One plain sentence."
          }
        },
        "required": [
          "id",
          "name",
          "anatomy",
          "occurrences",
          "hosts",
          "tier",
          "confidence",
          "reason"
        ],
        "additionalProperties": false,
        "description": "A pattern-candidate suggestion record. People decide; the tool suggests."
      }
    },
    "parked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ignoredTimes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "ignoredTimes"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "byTier": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "compound-component": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "variant": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "snowflake": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "pattern",
            "compound-component",
            "variant",
            "snowflake"
          ],
          "additionalProperties": false
        },
        "compositionsSeen": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "parked": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "candidates",
        "byTier",
        "compositionsSeen",
        "parked"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "meta",
    "root",
    "system",
    "thresholds",
    "candidates",
    "parked",
    "summary"
  ],
  "additionalProperties": false,
  "description": "Output of `dsa patterns`: pattern-candidate suggestion records.",
  "$defs": {
    "__schema0": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ds",
              "local",
              "html"
            ]
          },
          "shapeProps": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "children": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "component",
          "kind",
          "shapeProps",
          "children"
        ],
        "additionalProperties": false
      }
    }
  }
}
