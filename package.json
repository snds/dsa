{
  "name": "@snds/dsa",
  "version": "0.2.0",
  "description": "Design-system analytics: composition graph, pattern-candidate detection, adoption and correct-use metrics, and a CI ratchet. Library + CLI.",
  "license": "Apache-2.0",
  "author": "Sean Sands",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snds/dsa.git"
  },
  "homepage": "https://github.com/snds/dsa#readme",
  "bugs": "https://github.com/snds/dsa/issues",
  "keywords": [
    "design-system",
    "analytics",
    "adoption",
    "pattern-detection",
    "ts-morph",
    "jsx",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsa": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "data",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "node dist/schema/generate.js",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
